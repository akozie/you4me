<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav"
    app:startDestination="@id/signWithEmailAndGoogleFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.you4me.you4me.ui.authentication.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>
    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.you4me.you4me.ui.authentication.RegistrationFragment"
        android:label="fragment_registration"
        tools:layout="@layout/fragment_registration" >
        <action
            android:id="@+id/action_registrationFragment_to_loginFragment"
            app:destination="@id/loginFragment"/>
    </fragment>
    <fragment
        android:id="@+id/signWithEmailAndGoogleFragment"
        android:name="com.you4me.you4me.ui.authentication.SignWithEmailAndGoogleFragment"
        android:label="fragment_sign_with_email_and_google"
        tools:layout="@layout/fragment_sign_with_email_and_google" >
        <action
            android:id="@+id/action_signWithEmailAndGoogleFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_signWithEmailAndGoogleFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.you4me.you4me.ui.authentication.ForgotPasswordFragment"
        android:label="fragment_forgot_password"
        tools:layout="@layout/fragment_forgot_password" >
        <action
            android:id="@+id/action_forgotPasswordFragment_to_verificationCodeFragment"
            app:destination="@id/verificationCodeFragment" />
    </fragment>
    <fragment
        android:id="@+id/verificationCodeFragment"
        android:name="com.you4me.you4me.ui.authentication.VerificationCodeFragment"
        android:label="fragment_verification_code"
        tools:layout="@layout/fragment_verification_code" >
        <action
            android:id="@+id/action_verificationCodeFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_verificationCodeFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.you4me.you4me.ui.authentication.ChangePasswordFragment"
        android:label="fragment_change_password"
        tools:layout="@layout/fragment_change_password" >
        <action
            android:id="@+id/action_changePasswordFragment_to_passwordResetSuccessfulBottomSheetFragment"
            app:destination="@id/passwordResetSuccessfulBottomSheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/passwordResetSuccessfulBottomSheetFragment"
        android:name="com.you4me.you4me.ui.authentication.PasswordResetSuccessfulBottomSheetFragment"
        android:label="fragment_password_reset_successful_bottom_sheet"
        tools:layout="@layout/fragment_password_reset_successful_bottom_sheet" >
        <action
            android:id="@+id/action_passwordResetSuccessfulBottomSheetFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </dialog>
</navigation>