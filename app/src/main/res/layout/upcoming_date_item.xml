<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        tools:text="You have a date with jane doe at so so and so. Add to calendar" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/add_to_calender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_bg"
            android:padding="6dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_pink"
            android:text="@string/add_to_calendar" />

        <androidx.cardview.widget.CardView
            android:id="@+id/chat"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:elevation="@dimen/margin_10dp"
            app:cardElevation="@dimen/margin_10dp"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_marginEnd="@dimen/margin_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/chat_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send a message"
                android:gravity="center"
                android:background="@drawable/send_a_message"
                android:textColor="@color/primary_pink"
                android:paddingVertical="10dp" />

        </androidx.cardview.widget.CardView>


    </LinearLayout>



</LinearLayout>