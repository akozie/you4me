<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_container"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="@dimen/margin_10dp">

    <!-- Optional Date Header -->
    <TextView
        android:id="@+id/dateHeaderText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today"
        android:visibility="gone"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/black" />

    <!-- Notification Item Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Pink vertical bar -->
        <View
            android:id="@+id/view"
            android:layout_width="@dimen/margin_5dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/primary_pink" />

        <!-- Rounded card on the right -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/notification_lyt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_5dp"
            app:cardElevation="4dp"
            app:shapeAppearanceOverlay="@style/RightCornersOnly">

            <RelativeLayout
                android:id="@+id/relativeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_10dp">

                <ImageView
                    android:id="@+id/userImage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/profile_dotted_borders"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/baseline_person_24" />

                <TextView
                    android:id="@+id/notificationMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/userImage"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/userImage"
                    android:text="You've received a like from your date interest"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/userImage"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/userImage"
                    android:text="5:30 PM"
                    android:textColor="@color/text_grey"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/optionsMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/userImage"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="Options"
                    android:src="@drawable/menu" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
