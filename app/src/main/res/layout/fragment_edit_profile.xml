                            android:scaleType="centerCrop"
                            android:padding="0dp"
                            android:background="@drawable/image_rounded_corners"
                            android:clipToOutline="true"
                            android:outlineProvider="background"
                            android:contentDescription="Uploaded Image"
                            android:visibility="invisible" />

                        <!-- Add badge (only for empty slot) -->
                        <ImageView
                            android:id="@+id/addBadge1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/add_img_placeholder"
                            android:contentDescription="Add photo icon"
                            android:visibility="visible" />

                        <!-- Cancel icon -->
                        <ImageView
                            android:id="@+id/cancel1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/rectangle_shape_for_active"
                            android:src="@drawable/cancel_icon"
                            android:visibility="gone"
                            android:contentDescription="Remove photo" />
                    </FrameLayout>

