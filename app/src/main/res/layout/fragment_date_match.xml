<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp"
    tools:context=".ui.main.finddates.DateMatchFragment">


<!-- Heart icon -->
    <ImageView
        android:id="@+id/matchIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/big_love"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="It’s a Match"
        android:textSize="@dimen/text_size_28sp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/margin_10dp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/matchIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/descText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You and Lovie both want to go on a date. Your interest has been sent to Lovie. We’ll let know when Lovie accepted the date interest!"
        android:textSize="14sp"
        android:layout_margin="@dimen/margin_30dp"
        android:gravity="center"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile Images Row -->
    <LinearLayout
        android:id="@+id/profileRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/margin_20dp"
        app:layout_constraintTop_toBottomOf="@id/descText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/userImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/onboarding_img3"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:clipToOutline="true" />

        <ImageView
            android:id="@+id/heartBetween"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/big_love" />

        <ImageView
            android:id="@+id/matchImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/onboarding_screen"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:clipToOutline="true" />
    </LinearLayout>

    <!-- OKAY Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/okayButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/margin_55dp"
        android:layout_margin="@dimen/margin_20dp"
        android:background="@drawable/bg_rounded_button"
        android:text="OKAY!"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileRow" />
</androidx.constraintlayout.widget.ConstraintLayout>
