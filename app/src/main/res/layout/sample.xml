<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photos and Videos"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload a picture that shows the true you. The first picture will be used as your main picture and display photo."
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:id="@+id/photoGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Placeholder buttons for images -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <ImageButton
                    android:id="@+id/addPhotoButton6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/add_photo_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Add Photo" />
            </FrameLayout>

            <!-- Repeat similar blocks for all six placeholders -->
        </GridLayout>
    </LinearLayout>
</ScrollView>
